# Local credentials and runtime state
.env
.env.*
!.env.example
!.env.sample
.streamlit/secrets.toml
**/worker_credentials.json
**/local_connection.json
__pycache__/
*.py[cod]
.idea/
.vscode/
.venv*/
venv/
env/
.cache/
.integration_backups/
*.log
*.sqlite3*
*.safetensors
*.pt
*.gguf
*.bin
**/reports/
**/outputs/
**/checkpoints/

# Native PostgreSQL files are rebuilt from the tracked logical archive.
/database/data/*
!/database/data/exports/
!/database/data/regulations/
/database/data/local_db/
/database/logs/
*.dump
!/database/data/exports/*.dump

# Frozen training/evaluation datasets are explicitly included.
/qwen_factory/data/*
!/qwen_factory/data/production/
!/qwen_factory/data/eval/
!/qwen_factory/data/sample/
/qwen_factory/data/production/*
!/qwen_factory/data/production/curation_1500/
/qwen_factory/data/eval/*
!/qwen_factory/data/eval/prompts.jsonl
!/qwen_factory/data/eval/prompts.app_v1.jsonl
!/qwen_factory/data/eval/prompts.app_v1.manifest.json
!/qwen_factory/data/eval/prompts.app_v2.jsonl
!/qwen_factory/data/eval/prompts.app_v2.manifest.json
/qwen_factory/data/sample/*
!/qwen_factory/data/sample/processed/
!/qwen_factory/data/sample/eval/
!/qwen_factory/data/sample/manifest.json
/qwen_factory/data/sample/processed/*
!/qwen_factory/data/sample/processed/train.jsonl
!/qwen_factory/data/sample/processed/validation.jsonl
/qwen_factory/data/sample/eval/*
!/qwen_factory/data/sample/eval/test.jsonl
/qwen_factory/configs/local_recipe_*.yaml
/qwen_factory/configs/control_*.yaml

# Keep regulation originals; normalized intermediates already live in the DB archive.
/database/data/regulations/**
!/database/data/regulations/**/
!/database/data/regulations/**/*.pdf
!/database/data/regulations/**/*.docx
!/database/data/regulations/**/*.hwp
!/database/data/regulations/**/*.hwpx
!/database/data/regulations/**/*.xlsx
