# ==============================================================================
# 1. 공공데이터포털 API 인증키 (data.go.kr - 승인 완료)
# ==============================================================================
DATA_GO_KR_API_KEY=
KMOOC_SERVICE_KEY=

# ==============================================================================
# 2. 승인 외부 공공 API 키
# ==============================================================================
LIBRARY_AUTH_KEY=
LIBRARY_NARU_API_KEY=

CAREERNET_API_KEY=

# ==============================================================================
# 3. Supabase PostgreSQL 연결 URI
# ==============================================================================
# Supabase 대시보드 -> Project Settings -> Database -> Connection string -> URI
# 기본 포트(Direct Connection): 5432 / Pooler(Session Mode): 5432 / Transaction: 6543
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
TARGET_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SOURCE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ==============================================================================
# 4. Supabase REST API 접속 정보 (클라이언트 SDK 사용 시)
# ==============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ==============================================================================
# 5. OpenAI API 키 (IT 자료 AI 심사 및 임베딩용)
# ==============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# 자료 분류 모델은 코드에서 gpt-6-luna로 고정합니다. 아래 값은 분류 모델에 사용하지 않습니다.
OPENAI_MODEL=gpt-5-nano

EMBEDDING_MODEL=text-embedding-3-small

REGULATION_RAG_INCLUDE_REVIEW=true